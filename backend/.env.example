# Arynox AI - Backend environment configuration
# Copy to .env and fill in values.

# --- Database ---
DATABASE_URL=sqlite:///./arynox.db

# --- AI Provider ---
# Choose: ollama | openai | openrouter
AI_PROVIDER=ollama

# Default model used for agents (can be changed per-project from Settings UI)
AI_MODEL=qwen2.5-coder:7b

# --- OpenAI-compatible API ---
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# --- OpenRouter ---
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet

# --- Ollama (local models) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:7b
# Model pulled automatically when missing (set to false to only use installed models)
OLLAMA_AUTO_PULL=true
# Model recommended by the auto system-detect wizard for this machine
OLLAMA_DEFAULT_MODEL=

# --- Permissions ---
# Default permission mode for new projects: safe | ask | auto
DEFAULT_PERMISSION_MODE=ask

# --- Projects workspace root ---
PROJECTS_ROOT=../projects

# --- GitHub (optional: also settable from Settings UI > Integrations) ---
# Personal access token with "repo" scope. Used for pushing workspaces to GitHub.
GITHUB_TOKEN=

# --- MCP servers (JSON map: {"server-name": {"command": "...", "args": ["..."]}} or {"server-name": {"url": "..."}}) ---
MCP_SERVERS={}

# --- CORS ---
CORS_ORIGINS=http://localhost:3000
